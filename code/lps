    return dp[0][n-1]




from functools import lru_cache

def lps_recursive(s):
    n = len(s)

    @lru_cache(None)
    def solve(i, j):
        if i > j:
            return 0
        if i == j:
            return 1
        if s[i] == s[j]:
            return 2 + solve(i+1, j-1)
        else:
            return max(solve(i+1, j), solve(i, j-1))

    return solve(0, n-1)

