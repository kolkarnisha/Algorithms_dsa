def compute_lps(pattern):
    """
    Build the LPS (Longest Prefix that is also a Suffix) array
    for the given pattern string.

    lps[i] = length of the longest proper prefix of pattern[0..i]
             that is also a suffix of pattern[0..i]
    """
    n = len(pattern)
    lps = [0] * n          # lps[0] is always 0
    length = 0             # length of the current matched prefix/suffix
    i = 1                  # start comparing from the second character

    while i < n:
        if pattern[i] == pattern[length]:
            # characters match: extend the matched length
            length += 1
            lps[i] = length
            i += 1
        else:
            if length != 0:
                # fall back to the previous best-known prefix length
                # instead of restarting from zero
                length = lps[length - 1]
                # note: i is NOT incremented here — we retry the comparison
            else:
                # no match and nothing to fall back to
                lps[i] = 0
                i += 1

    return lps


if __name__ == "__main__":
    pattern = "AABAACAABAA"
    result = compute_lps(pattern)

    print(f"Pattern: {pattern}")
    print(f"LPS:     {result}")

    # Pretty print aligned columns
    print("\nindex : " + " ".join(f"{i:>2}" for i in range(len(pattern))))
    print("char  : " + " ".join(f"{c:>2}" for c in pattern))
    print("lps   : " + " ".join(f"{v:>2}" for v in result))
